            "instruction": "Please answer the following pre-screen questions before continuing.",
            "nextButtonText": "Continue to study instructions",
            "response": [
                {
                    "id": "ps-age",
                    "prompt": "What is your age?",
                    "secondaryText": "Please enter your age in years.",
                    "type": "numerical",
                    "min": 18,
                    "max": 100,
                    "location": "aboveStimulus"
                },
                {
                    "id": "ps-vision",
                    "prompt": "Do you have normal or corrected-to-normal vision?",
                    "type": "radio",
                    "location": "aboveStimulus",
                    "options": [
                        "Yes",
                        "No"
                    ]
                },
                {
                    "id": "ps-color-vision",
                    "prompt": "Do you have color vision deficiency?",
                    "type": "radio",
                    "location": "aboveStimulus",
                    "options": [
                        "No",
                        "Yes",
                        "Unsure"
                    ]
