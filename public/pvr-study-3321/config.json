{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "PVR — Study 3",
        "version": "pilot",
        "date": "2026-08-21",
        "description": "Between-subjects tutorial ratio exposure (small vs large); main session ratios 3–6000 (pvr-study-3321)",
        "authors": [
            "Yvonne Jansen",
            "Leni Yang",
            "Pierre Dragicevic"
        ],
        "organizations": [
            "Inria Bordeaux",
            "CNRS"
        ]
    },
    "uiConfig": {
        "contactEmail": "leni.yang@inria.fr",
        "helpTextPath": "pvr-study-3321/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": true,
        "showTitle": false,
        "windowEventDebounceTime": 100,
        "numSequences": 50,
        "studyEndMsg": "Thank you for taking part in this study.\n\nYou will be redirected to Prolific in 5 seconds to confirm your task completion.",
        "studyEndAutoRedirectURL": "https://app.prolific.com/submissions/complete?cc=C3IEH2C1",
        "studyEndAutoRedirectDelay": 5000,
        "urlParticipantIdParam": "PROLIFIC_PID"
    },
    "studyRules": {
        "display": {
            "minWidth": 842,
            "minHeight": 700,
            "blockedMessage": "This study requires your browser window to be at least 842 × 700 pixels in landscape orientation. Please use a tablet (held horizontally), laptop, or desktop, and make sure your browser window is maximized."
        }
    },
    "baseComponents": {
        "bar-chart": {
            "type": "website",
            "response": [
                {
                    "id": "barChart",
                    "prompt": "",
                    "required": true,
                    "hidden": true,
                    "location": "belowStimulus",
                    "type": "reactive"
                },
                {
                    "id": "scrollMetrics",
                    "prompt": "",
                    "required": true,
                    "hidden": true,
                    "location": "belowStimulus",
                    "type": "reactive"
                }
            ],
            "path": "pvr-study-3321/assets/bar-chart-main.html",
            "instructionLocation": "sidebar",
            "nextOnEnter": true
        },
        "bar-chart-tutorial": {
            "type": "website",
            "response": [
                {
                    "id": "barChart",
                    "prompt": "",
                    "required": true,
