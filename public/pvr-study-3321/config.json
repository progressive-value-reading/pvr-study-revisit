            "instructionLocation": "sidebar",
            "nextOnEnter": true
        }
    },
    "components": {
        "consent": {
            "type": "markdown",
            "path": "pvr-study-3321/assets/consent.md",
            "nextButtonText": "Next",
            "withSidebar": false,
            "response": [
                {
                    "id": "agree-to-participate",
                    "prompt": "Do you agree to participate in the study?",
                    "type": "radio",
                    "location": "belowStimulus",
                    "options": [
                        "Yes",
                        "No"
                    ]
                }
            ],
            "nextOnEnter": true
        },
        "instruction": {
            "type": "markdown",
            "path": "pvr-study-3321/assets/instruction.md",
            "nextButtonText": "I read every instruction clearly. And I am ready to enter the tutorial session.",
            "withSidebar": false,
            "response": []
        },
        "transition-to-main": {
            "type": "markdown",
            "path": "pvr-study-3321/assets/transition-to-main.md",
            "nextButtonText": "Next",
            "withSidebar": false,
            "response": [],
            "nextOnEnter": true
        },
        "transition-scroll": {
            "type": "markdown",
            "path": "pvr-study-3321/assets/transition-scroll.md",
            "nextButtonText": "Next",
            "withSidebar": false,
            "response": [],
            "nextOnEnter": true
        },
        "pre-screen": {
            "type": "image",
            "path": "pvr-study-3321/assets/grey-scale.png",
            "description": "Pre-screening form on one page",
            "nextButtonText": "Next",
            "style": {
                "width": "500px",
                "border": "1px solid #999"
            },
            "response": [
                {
                    "id": "ps-grey-scale-response",
                    "prompt": "Please enter the number shown in the image bleow. This is to verify that your screen can properly display the charts we will use.",
                    "type": "shortText",
                    "placeholder": "e.g. 123",
                    "location": "aboveStimulus"
                },
                {
                    "id": "ps-vision",
                    "prompt": "Do you have normal or corrected-to-normal vision?",
                    "type": "radio",
                    "location": "belowStimulus",
                    "options": [
                        "Yes",
                        "No"
                    ]
                },
                {
                    "id": "ps-device-check",
                    "prompt": "Are you currently using a tablet, laptop or desktop computer?",
                    "type": "radio",
                    "location": "belowStimulus",
                    "options": [
                        "Yes",
                        "No"
                    ]
                },
                {
                    "id": "prolificId",
                    "prompt": "Please enter your Prolific ID",
                    "required": true,
                    "location": "belowStimulus",
                    "type": "shortText",
                    "placeholder": "Prolific ID",
                    "paramCapture": "PROLIFIC_PID"
                }
            ],
            "nextOnEnter": true
        },
        "non-qualified": {
            "type": "website",
            "path": "pvr-study-3321/assets/non-qualified.html",
            "nextButtonText": "Finish",
            "response": [
                {
                    "id": "nq-finish",
                    "prompt": "",
                    "type": "radio",
                    "location": "belowStimulus",
                    "hidden": true,
                    "options": [
                        "Finish"
                    ],
                    "default": "Finish"
                }
            ]
        },
        "study-complete": {
            "type": "markdown",
            "path": "pvr-study-3321/assets/study-complete.md",
            "nextButtonText": "Finish",
            "nextOnEnter": true,
            "response": [
                {
                    "id": "finish-confirm",
                    "prompt": "Please confirm your submission:",
                    "type": "radio",
                    "location": "belowStimulus",
                    "options": [
                        "Submit"
                    ]
                }
            ]
        },
        "pre-screen-scroll": {
            "type": "website",
            "path": "pvr-study-3321/assets/scroll-test.html",
            "description": "Scroll capability screening",
            "instruction": "Scroll upward in the frame until you see a number. Then enter the number in the text field below.\n\n**Important:**\n- You can only scroll upward toward the top of the frame; scrolling backward (back down) is not possible.\n- Select a scrolling method that feels comfortable (e.g., mousewheel or trackpad), and use the same method throughout the experiment.",
            "instructionLocation": "sidebar",
            "nextButtonText": "Next",
            "style": {
                "width": "500px",
                "height": "500px"
            },
            "response": [
                {
                    "id": "ps-scroll-response",
                    "prompt": "Number you saw at the top of the frame:",
                    "type": "shortText",
                    "placeholder": "e.g. 123",
                    "location": "belowStimulus"
                }
            ],
            "nextOnEnter": true
        },
        "post-study-feedback": {
            "type": "questionnaire",
            "description": "Post-study feedback form",
            "instruction": "",
            "nextButtonText": "Continue",
            "response": [
                {
                    "id": "post-scroll-method",
                    "prompt": "Please tell us the scroll method you used in this study:",
                    "type": "longText",
                    "location": "aboveStimulus",
                    "placeholder": "e.g. mousewheel, trackpad, touch scrolling, pageup/down keys"
                },
                {
                    "id": "post-scroll-count-frequency",
                    "prompt": "<strong>Among the trials that required scrolling</strong>, how often did you count the number of scrolls you made to estimate? Your honest answer is very important for our analysis. Whether you counted or not, it won't affect your compensation.",
                    "type": "radio",
                    "location": "aboveStimulus",
                    "required": true,
                    "options": [
                        "Never",
                        "Rarely",
                        "Sometimes",
                        "Most of the time",
                        "Always"
                    ]
                },
                {
                    "id": "post-estimation-strategy",
                    "prompt": "Please describe your estimation strategies. If you used multiple strategies, please describe all of them.",
                    "type": "longText",
                    "location": "aboveStimulus",
                    "required": true
                },
                {
                    "id": "post-prior-scrollable-viz-frequency",
                    "prompt": "In this study, you sometimes had to scroll to see the full height of a bar in a chart. **Before participating today**, have you  ever seen similar charts or visualizations on the web—where you needed to scroll to view an entire data value?",
                    "type": "radio",
                    "location": "aboveStimulus",
                    "required": true,
                    "options": [
                        "Never",
                        "Only once",
                        "2-5 times",
                        "More than 5 times"
                    ]
                },
                {
                    "id": "post-prior-scrollable-viz-example",
                    "prompt": "If any specific examples come to mind, you may share titles or links below.",
                    "type": "shortText",
                    "location": "aboveStimulus",
                    "required": false,
                    "placeholder": "e.g. a news articles, dashboards, or website names—or paste URLs"
                },
                {
                    "id": "post-task-feedback",
                    "prompt": "If you have any feedback on your experience with the task, we would appreciate your input, for example, anything unclear or difficult about the instructions or task.",
                    "type": "longText",
                    "location": "aboveStimulus",
                    "required": false,
                    "placeholder": "Share any feedback about the task or instructions, or leave blank."
                }
            ]
        },
