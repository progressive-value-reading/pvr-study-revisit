    "sequence": {
        "order": "fixed",
        "components": [
            {
                "id": "consent-flow",
                "order": "fixed",
                "components": [
                    "consent"
                ],
                "skip": [
                    {
                        "name": "consent",
                        "check": "response",
                        "responseId": "agree-to-participate",
                        "value": "No",
                        "comparison": "equal",
                        "to": "non-qualified"
                    }
                ]
            },
            {
                "id": "screening-flow",
                "order": "fixed",
                "components": [
                    "pre-screen",
                    "pre-screen-scroll"
                ],
                "skip": [
                    {
                        "name": "pre-screen",
